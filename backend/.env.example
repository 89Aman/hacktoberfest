# ==============================================================================
# Campus Rescue — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in this directory (or project root):
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Google GenAI / Gemma 4 API Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# If left unset or invalid, the system automatically runs in Structured Fallback Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier for Google GenAI SDK (Default: gemma-4-26b-a4b-it)
# Alternatives: gemini-2.5-flash, gemini-2.5-pro
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database (Optional Persistence)
# ------------------------------------------------------------------------------
# If omitted, Campus Rescue operates using the high-performance in-memory store
# initialized with seeded campus rooms and schedule events.
# Found in: Supabase Project Settings -> API (Project URL & Anon Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ------------------------------------------------------------------------------
# 3. Server Network & Host Configuration
# ------------------------------------------------------------------------------
# Host interface for Uvicorn
HOST=0.0.0.0

# Server port (Default: 8000 matches Vite dev proxy in frontend/vite.config.js)
PORT=8000

# Environment mode ('development' | 'production' | 'test')
ENVIRONMENT=development
