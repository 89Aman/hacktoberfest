# ==============================================================================
# Campus Rescue — Root Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' at project root:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Google GenAI / Gemma 4 API Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# If left unset, Campus Rescue runs automatically in Structured Fallback Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier for Google GenAI SDK (Default: gemma-4-26b-a4b-it)
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database (Optional Persistence)
# ------------------------------------------------------------------------------
# If omitted, the backend runs in-memory with pre-seeded campus rooms and events.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ------------------------------------------------------------------------------
# 3. Server Network & Host Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
