# ==============================================================================
# Campus Rescue — Frontend (Vite + React) Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the frontend directory:
#   cp .env.example .env

# Supabase Client Configuration (Optional)
# If left blank, the frontend interacts with the FastAPI backend without direct Supabase subscriptions.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
